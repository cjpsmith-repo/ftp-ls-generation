  },
  {
   "id": "X6",
   "rule": "Full-name enforcement at ambiguous bare-name mentions: Miles, Wilson, Kane, Dawson, Hawkins, Grey, plus post-rename residuals"
  },
  {
   "id": "X7",
   "rule": "Celestial Paragon -> Demi-Immortal (race mentions) but keep 'Golden Celestial Paragon' as the Talent Tablet title"
  },
  {
   "id": "X8",
   "rule": "Secret Realm bare uses not covered by T9: decide per location"
  },
  {
   "id": "X9",
